# Copy to .env (git-ignored). Local-only values; nothing here is a real secret.
POSTGRES_PASSWORD=kuuma-local
AI_DB_PASSWORD=ai-local
COMPANION_DB_PASSWORD=companion-local
CASEFILE_DB_PASSWORD=casefile-local
GUARDIAN_DB_PASSWORD=guardian-local
MINIO_ROOT_USER=kuuma
MINIO_ROOT_PASSWORD=kuuma-local-minio
# HMAC key for case-ID tokens. `make bootstrap` replaces this with a random value.
KUUMA_CASE_TOKEN_KEY=change-me
# Salt for OpaqueRef hashing on the server side (test only).
KUUMA_REF_SALT=change-me
# Host phones use to reach MinIO for case bundles (localhost:9000 on the laptop, 10.0.2.2:9000 from an emulator).
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Seed of the LOCAL mock timestamp authority (Casefile). Replace with a real RFC 3161 authority before the pilot.
KUUMA_TSA_SEED=kuuma-local-mock-tsa
