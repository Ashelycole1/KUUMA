<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed by the Flutter tool for hot reload and the debugger. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Debug only: `make fake SCENARIO=<name>` sends this broadcast over adb. -->
        <receiver
            android:name=".debug.ScenarioReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="ug.kuuma.debug.PLAY_SCENARIO"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
