{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kuuma.ug/api/feedback-request.json",
  "title": "FeedbackRequest",
  "description": "Sent only when the child consented to training (consentToTrain).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flagId",
    "verdict",
    "modelVersion"
  ],
  "properties": {
    "flagId": {
      "$ref": "../types/uuid.json"
    },
    "verdict": {
      "$ref": "../types/feedback-verdict.json"
    },
    "category": {
      "$ref": "../types/harm-category.json"
    },
    "modelVersion": {
      "type": "string"
    }
  }
}
