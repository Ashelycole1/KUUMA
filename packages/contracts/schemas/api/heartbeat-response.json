{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kuuma.ug/api/heartbeat-response.json",
  "title": "HeartbeatResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "latestPolicyVersion",
    "serverTime"
  ],
  "properties": {
    "latestPolicyVersion": {
      "type": "integer",
      "minimum": 0
    },
    "serverTime": {
      "$ref": "../types/timestamp.json"
    },
    "policy": {
      "$ref": "../types/policy.json",
      "description": "Present when a newer policy than the phone's exists."
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "approval-result.json"
      },
      "description": "Parent decisions on this child's approval requests not yet delivered."
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "../types/report-order.json"
      },
      "description": "Parent report requests for this child not yet delivered."
    }
  }
}
