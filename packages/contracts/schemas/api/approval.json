{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kuuma.ug/api/approval.json",
  "title": "Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalId",
    "requestId",
    "caseId",
    "kind",
    "status",
    "createdAt"
  ],
  "properties": {
    "approvalId": {
      "$ref": "../types/uuid.json"
    },
    "requestId": {
      "$ref": "../types/uuid.json"
    },
    "caseId": {
      "$ref": "../types/uuid.json"
    },
    "childId": {
      "$ref": "../types/uuid.json",
      "description": "The child the request came from, so the parent's phone signs with that child's family key."
    },
    "kind": {
      "$ref": "../types/approval-kind.json"
    },
    "recipientType": {
      "$ref": "../types/recipient-type.json"
    },
    "status": {
      "$ref": "../types/approval-status.json"
    },
    "createdAt": {
      "$ref": "../types/timestamp.json"
    },
    "decidedAt": {
      "$ref": "../types/timestamp.json"
    }
  }
}
